{
  "expo": {
    "name": "Magick Tailor",
    "slug": "tls",
    "scheme": "tls",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14213A"
    },
    "ios": {
      "bundleIdentifier": "com.generalmagickindustries.magicktls",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.generalmagickindustries.magicktls",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14213A"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Magick Tailor uses your photos to attach a picture or short video to a post.",
          "cameraPermission": false,
          "microphonePermission": "Magick Tailor uses the microphone to dictate measurements during a fitting."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14213A"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14213A"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Magick Tailor uses the microphone to dictate measurements during a fitting.",
          "speechRecognitionPermission": "Magick Tailor turns your dictated measurements into text on this phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89420201-64c7-4632-ae7a-87e4ffbc3373"
      }
    },
    "owner": "shamubtrs-team"
  }
}
