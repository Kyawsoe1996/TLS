# Copy to .dev.vars for local development (never commit .dev.vars).
# In production set each of these with: wrangler secret put <NAME>

# Clerk (https://dashboard.clerk.com -> API keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Turso (turso db show <name> --url / turso db tokens create <name>)
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSJ9.xxxxx

# Upstash Redis (REST) - optional locally; if missing, AI rate limiting is skipped
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxx

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.1-flash-lite

# Resend (https://resend.com/api-keys) - optional; without it emails are logged as "simulated", not sent
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional sender, e.g. "Shop <hello@yourdomain.com>"; must be a verified Resend domain.
# Default onboarding@resend.dev (Resend's test sender: only delivers to your own Resend account email).
RESEND_FROM=

# Origin used in the media links handed to the app. Required locally: wrangler dev rewrites request URLs to
# the custom domain in wrangler.toml, so without this the app would try to load dev photos from production.
# iOS simulator: http://localhost:8787 - Android emulator: http://10.0.2.2:8787
PUBLIC_URL=http://localhost:8787

# Amazon S3 bucket for post photos / videos - optional; without all four, uploads are switched off (400).
# The IAM user needs s3:PutObject, s3:GetObject, s3:DeleteObject and s3:ListBucket on the bucket.
S3_BUCKET=company-bucket-name
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Folder inside the bucket; keep dev and production apart.
S3_PREFIX=magicktls/dev
# Only for S3-compatible storage (MinIO etc.), path-style: https://s3.example.com. Leave unset for AWS.
# S3_ENDPOINT=
