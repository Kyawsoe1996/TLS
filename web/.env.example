# Copy this file to .env.local and fill in real values. NEVER commit real keys.
# Next.js auto-loads .env.local (and .env). Server code reads these at runtime.

# --- Gemini (server-side only; NO NEXT_PUBLIC prefix, so it never reaches the browser) ---
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here
# Optional model override; defaults to gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase (auth + database; needed when you wire the next phase) ---
# Supabase dashboard → Project Settings → API. The anon key is public-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Google Search Console (optional; real SEO rankings) ---
# Google Cloud Console → enable "Google Search Console API" → Credentials →
# OAuth client ID (Web application). Add the redirect URI below to the client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/seo/callback

# --- Resend (optional; sending re-engagement emails) ---
# https://resend.com → API Keys. Without a verified domain, send from
# onboarding@resend.dev to your own account email. Sends are simulated if unset.
RESEND_API_KEY=
RESEND_FROM=TLS <onboarding@resend.dev>
